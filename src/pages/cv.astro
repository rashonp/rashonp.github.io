---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---
<Layout title="CV & Contact">
  <div class="page-intro"><h1>CV & contact</h1><a class="button" href={site.cv}>View my CV</a></div>
  <section class="section" aria-labelledby="education"><div class="section-heading"><h2 id="education">Education</h2></div><div class="education">
    <article><h3>University of Michigan</h3><p>PhD in Computer Science · In progress</p></article>
    <article><h3>Stanford University</h3><p>Master’s in Computer Science · HCI and AI</p></article>
    <article><h3>Michigan State University</h3><p>Bachelor’s in Computer Science</p></article>
  </div></section>
  <section class="card"><h2>Get in touch</h2><p><a href={'mailto:' + site.email}>{site.email}</a></p><div class="actions"><a class="text-link" href={site.linkedin}>LinkedIn ↗</a><a class="text-link" href={site.orcid}>ORCID ↗</a><a class="text-link" href={site.scholar}>Google Scholar ↗</a></div></section>
</Layout>
