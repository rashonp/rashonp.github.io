---
import Layout from '../layouts/Layout.astro';
import PaperCard from '../components/PaperCard.astro';
import AIBiasCard from '../components/AIBiasCard.astro';
import NewsSidebar from '../components/NewsSidebar.astro';
import { site } from '../data/site';
---
<Layout wide>
  <div class="home-grid">
  <section class="hero" aria-labelledby="intro">
    <div>
      <h1 id="intro">Rashon Poole</h1>
      <p class="intro">PhD student in Computer Science<br />University of Michigan</p>
      <p>My work brings together human-computer interaction, AI alignment, and AI ethics.</p>
      <div class="actions">
        <a class="text-link" href={'mailto:' + site.email}>Email</a>
        <a class="text-link" href={site.linkedin}>LinkedIn</a>
        <a class="text-link" href={site.orcid}>ORCID</a>
        <a class="text-link" href={site.scholar}>Google Scholar</a>
      </div>
    </div>
    <figure class="portrait"><img src="/assets/img/rashon_poole.JPG" alt="Rashon Poole" width="420" height="480" fetchpriority="high" /></figure>
  </section>
  <div class="home-content">
  <section class="section" aria-labelledby="about">
    <div class="section-heading"><h2 id="about">About me</h2></div>
    <div class="prose">
      <p>I’m a 2nd year PhD student in Computer Science and Engineering at the University of Michigan, working at the intersection of human-computer interaction, AI alignment, and AI ethics. My research develops AI systems that give users greater agency over how information is presented, interpreted, and personalized to them. I also study the ethical, legal, and societal implications of AI systems and the normative choices embedded in their design and deployment.</p>
      <p>I completed my Master’s in Computer Science at Stanford University, where I specialized in human-computer interaction (HCI) and artificial intelligence. I earned my Bachelor’s degree in Computer Science from Michigan State University and completed internships in tech/software, aerospace, and energy.</p>    
    </div>
  </section>
  <section class="section" aria-labelledby="recent-work">
    <div class="section-heading"><h2 id="recent-work">Recent work</h2></div>
    <PaperCard />
    <AIBiasCard />
  </section>
  </div>
  <NewsSidebar />
  </div>
</Layout>
